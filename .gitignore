.DS_Store
.auth.json

# generated staging: markdown the KB is rendered from, never committed
.build/

# the product checkout the harness drives
canvas/live/

# harness scratch: logs and the rewritten lockfile are regenerated by harness/install.mjs
harness/*.log
harness/yarn.public.lock

# A capture taken from a REAL signed-in screen (scripts/measure-real.mjs).
# The JSON is safe and IS committed — the walker records geometry and computed
# styles and no text, href, src, id or value, and scripts/leaks.mjs proves it
# before the file is written. The PNG is a different matter: it is a picture of
# somebody's account, with their listings, prices and avatar in it. It stays
# local, and so does the SingleFile it came from.
data/live/*.real.png
data/ours/*.real.png
